#!/usr/bin/env bash

# practically everything here is copied from somewhere else
# this script should be idempotent - safe to run multiple times on the same machine

# exit script if any command fails
set -e
# print each line before running
set -x

# Close any open System Preferences panes, to prevent them from overriding
# settings we’re about to change


###############################################################################
# homebrew                                                                    #
###############################################################################

/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

brew install tmux neovim deno fzf ripgrep
brew install --cask ghostty spotify firefox


###############################################################################
# language servers                                                            #
###############################################################################

brew install gopls python-lsp-server


###############################################################################
# tmux plugins                                                                #
###############################################################################

if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
  git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi
"$HOME/.tmux/plugins/tpm/bin/install_plugins"


###############################################################################
# vim plugins                                                                 #
###############################################################################


###############################################################################
# config                                                                      #
###############################################################################

mkdir -p "$HOME/.config"

ln -sf $HOME/dotfiles/aliases $HOME/.aliases
ln -sf $HOME/dotfiles/bash_profile $HOME/.bash_profile
ln -sf $HOME/dotfiles/commonprofile $HOME/.commonprofile
ln -sf $HOME/dotfiles/functions $HOME/.functions
ln -sf $HOME/dotfiles/tmux.conf $HOME/.tmux.conf
ln -sf $HOME/dotfiles/vimrc $HOME/.vimrc
ln -sf $HOME/dotfiles/zshrc $HOME/.zshrc

ln -sf $HOME/dotfiles/global_gitignore $HOME/.global_gitignore
git config --global core.excludesfile $HOME/.global_gitignore

ln -sf $HOME/dotfiles/ripgreprc $HOME/.config/ripgreprc

mkdir -p $HOME/.config/nvim/
ln -sfn $HOME/dotfiles/snippets $HOME/.config/nvim/snippets
ln -sf $HOME/dotfiles/nvim_init.lua $HOME/.config/nvim/init.lua

nvim --headless +qall

ln -sfn $HOME/dotfiles/zsh-completion $HOME/.zsh-completion

# let nvim find ftplugins
mkdir -p $HOME/.config/nvim/after
ln -sfn $HOME/dotfiles/ftplugin $HOME/.config/nvim/after/ftplugin
ln -sfn $HOME/dotfiles/lua $HOME/.config/nvim/lua


###############################################################################
# Colorscheme                                                                 #
##############################################################################

# Load into iterm manually
mkdir -p $HOME/tools

git config --global column.ui auto
git config --global branch.sort -committerdate
git config --global tag.sort version:refname
git config --global diff.algorithm histogram
git config --global push.autoSetupRemote true
git config --global user.email "zhiyanfoo@gmail.com"
git config --global user.name "Zhiyan Foo"
