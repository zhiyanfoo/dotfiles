delete_branches() {
    if [ -z "$1" ]
    then
        echo "Usage: ./delete_branches_with_prefix.sh <prefix>"
        exit 1
    fi

    # Set the prefix
    prefix=$1

    # Fetch and prune remote branches
    git fetch --all --prune

    # Find all local branches with the specified prefix and delete them
    git branch | grep "^  $prefix" | xargs -I{} git branch -D {}
}


ghpr() {
    local default_repo_prefix="DataDog"
    local repo_prefix="$1"
    local repo="$2"
    local pull_request="$3"

    if [[ $# -eq 1 ]]; then
        # If only one argument, assume it's the pull request number and use default repo and prefix
        pull_request="$repo_prefix"
        repo="service-discovery-platform"
        repo_prefix="$default_repo_prefix"
    elif [[ $# -eq 2 ]]; then
        # If only two arguments, assume it's the pull request number and use default repo prefix
        pull_request="$repo"
        repo="$repo_prefix"
        repo_prefix="$default_repo_prefix"
    fi

    # Open the GitHub PR in the default web browser
    if command -v xdg-open > /dev/null; then
        # Linux
        xdg-open "https://github.com/${repo_prefix}/${repo}/pull/${pull_request}"
    elif command -v open > /dev/null; then
        # macOS
        open "https://github.com/${repo_prefix}/${repo}/pull/${pull_request}"
    else
        echo "Unable to open the pull request in a browser."
    fi
}

cmcp() {
    local mcp_dir="$HOME/tools/mcp"
    local -a configs
    for cfg in "$mcp_dir"/*.json; do
        [ -e "$cfg" ] && configs+=(--mcp-config "$cfg")
    done
    claude --dangerously-skip-permissions --model opus "${configs[@]}" "$@"
}

ansi2txt() {
    while IFS= read -r line; do
        echo "$line" | sed -r "s/\x1B\[([0-9]{1,2}(;[0-9]{1,2})?)?[m|K]//g"
    done
}

codexmcp() {
    local mcp_dir="${CODEX_MCP_DIR:-$HOME/tools/mcp}"
    local -a configs
    local cfg config

    if ! command -v jq >/dev/null 2>&1; then
        echo "codexmcp: jq is required to read MCP JSON configs" >&2
        return 1
    fi

    for cfg in "$mcp_dir"/*.json(N); do
        while IFS= read -r config; do
            configs+=(-c "$config")
        done < <(jq -r '
            (.mcpServers // {})
            | to_entries[]
            | select(.value.url != null)
            | "mcp_servers.\(.key).url=\(.value.url | tojson)",
              (if (.value.bearerTokenEnvVar // .value.bearer_token_env_var) then
                "mcp_servers.\(.key).bearer_token_env_var=\((.value.bearerTokenEnvVar // .value.bearer_token_env_var) | tojson)"
              else empty end)
        ' "$cfg")
    done

    codex "${configs[@]}" "$@"
}
